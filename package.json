{
  "name": "multiplex",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "up": "docker compose -f infra/local/docker-compose.yaml up -d",
    "down": "docker compose -f infra/local/docker-compose.yaml down",
    "logs": "docker compose -f infra/local/docker-compose.yaml logs -f --tail=200",
    "lint": "oxlint --type-aware src/ test/",
    "lint:format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:integration": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "makemigrations": "prisma migrate dev --name schema-change",
    "migrate": "prisma migrate deploy",
    "migrate:check": "prisma validate",
    "migrate:docker": "docker compose -f infra/local/docker-compose.yaml exec api prisma migrate deploy",
    "coverage": "vitest run --coverage",
    "health": "curl --fail --retry 30 --retry-all-errors --retry-delay 1 http://localhost:8000/health/live && curl --fail --retry 30 --retry-all-errors --retry-delay 1 http://localhost:8000/health/ready",
    "observability": "docker ps -a --format 'table {{.Names}}\\t{{.Image}}\\t{{.ID}}\\t{{.Status}}' && curl --fail --retry 30 --retry-all-errors --retry-delay 1 http://localhost:3000/api/health && curl --fail --retry 30 --retry-all-errors --retry-delay 1 http://localhost:9090/-/healthy && curl --fail --retry 30 --retry-all-errors --retry-delay 1 http://localhost:3100/ready && curl --fail --retry 30 --retry-all-errors --retry-delay 1 http://localhost:3200/ready"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/instrumentation-amqplib": "^0.69.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.77.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.35.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "^6.16.0",
    "@types/amqplib": "^0.10.8",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "ioredis": "^6.0.0",
    "nestjs-otel": "^8.1.1",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^6.16.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
